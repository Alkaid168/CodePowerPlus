{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CodePowerPlus knowledge tree",
  "description": "题目标签词表：只有名称与层级，没有描述性字段。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "nodes"
  ],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]{4}\\.[0-9]{2}\\.[0-9]+$"
    },
    "provenance": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "level",
          "parent_id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "level": {
            "type": "integer",
            "enum": [
              1,
              2,
              3
            ]
          },
          "parent_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
              },
              {
                "type": "null"
              }
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 20,
            "maxLength": 400,
            "pattern": "\\S"
          }
        }
      }
    }
  }
}
